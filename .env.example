# Vercel server-side environment; these two values are PUBLIC project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy projects may use SUPABASE_ANON_KEY instead.
# Never put a service_role / sb_secret_ key in a public config variable.

# Existing Shopier values stay server-side.
SHOPIER_PAT=
SHOPIER_API_BASE=https://api.shopier.com/v1
KEYORA_ADMIN_TOKEN=
KEYORA_SITE_URL=https://keyora-eight.vercel.app
